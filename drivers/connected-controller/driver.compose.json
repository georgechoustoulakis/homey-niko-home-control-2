{
  "name": {
    "en": "Connected Controller",
    "nl": "Connected Controller",
    "fr": "Unité de contrôle connectée",
    "da": "Connected controller",
    "sv": "Ansluten kontrollenhet"
  },
  "class": "bridge",
  "capabilities": ["jwt_remaining_days"],
  "platforms": ["local"],
  "connectivity": ["lan"],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  },
  "pair": [
    {
      "id": "discover"
    },
    {
      "id": "connect",
      "navigation": {
        "prev": "discover"
      }
    }
  ],
  "repair": [
    {
      "id": "connect",
      "options": {
        "repair": true
      }
    }
  ]
